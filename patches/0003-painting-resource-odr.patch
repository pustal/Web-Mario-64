+class PaintingResource : public Ship::Resource<PaintingData> {
   public:
     using Resource::Resource;
 
-    Painting() : Resource(std::shared_ptr<Ship::ResourceInitData>()) {}
+    PaintingResource() : Resource(std::shared_ptr<Ship::ResourceInitData>()) {}
 
     PaintingData* GetPointer();
     size_t GetPointerSize();
